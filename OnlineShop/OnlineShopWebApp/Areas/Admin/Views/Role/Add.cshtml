@model Role
<form method="post" asp-area="admin" asp-controller="Admin" asp-action="AddRole">
    <div class="row">
        @await Html.PartialAsync("AdminLeftMenu")
        <div class="col-md-9">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Создание новой роли</h3>
                </div>
                <div class="card-body">
                    <div class="text-danger font-weight-bold" asp-validation-summary="ModelOnly"></div>

                    <div class="form-group mb-3">
                        <label asp-for="Name" class="form-label">Название роли *</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-tag"></i></span>
                            <input asp-for="Name" class="form-control" placeholder="Введите название роли" />
                        </div>
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="form-actions mt-4">
                        <button type="submit" 
                            asp-area="Admin"
                            asp-controller="Role"
                            asp-action="Add"
                            class="btn btn-success">
                            <i class="fas fa-plus-circle"></i> Добавить роль
                        </button>
                        <a asp-controller="Admin" asp-action="Roles" class="btn btn-secondary ms-2">
                            <i class="fas fa-arrow-left"></i> Назад к списку
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>
