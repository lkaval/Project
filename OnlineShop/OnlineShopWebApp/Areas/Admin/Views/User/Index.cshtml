@using OnlineShopWebApp.Data.Models
@model List<UserAccount>

<div class="row">
    @await Html.PartialAsync("AdminLeftMenu")
    <div class="col-md-9">
        <h3 class="mb-4">Список пользователей</h3>
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Email</th>
                    <th>Роль</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>@user.Id</td>
                        <td>@user.Name</td>
                        <td>
                            <span class="badge @(user.Role?.Name == "Admin" ? "bg-danger" : "bg-secondary")">
                                @user.Role?.Name
                            </span>
                        </td>
                        <td>
                            <a asp-area="Admin" asp-controller="User" asp-action="Edit"
                               asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary">
                                Редактировать
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
