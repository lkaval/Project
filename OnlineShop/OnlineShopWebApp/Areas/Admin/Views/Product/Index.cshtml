@using OnlineShopWebApp.Data.Models
@model List<Product>

<div class="row">
    @await Html.PartialAsync("AdminLeftMenu")

    <div class="col-9">
        <h3>Список продуктов</h3>
        <a asp-area="Admin"
           asp-controller="Product"
           asp-action="Add">Добавить новый продукт</a>
        <div class="row">
            <table class="table">
                <thead>
                    <tr>
                        <th>№</th>
                        <th>Название</th>
                        <th>Цена</th>
                        <th></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        <tr>
                            <td>@(i + 1)</td>
                            <td>@Model[i].Name</td>
                            <td>@Model[i].Cost руб.</td>
                            <td>
                                <a asp-area="Admin"
                                   asp-controller="Product"
                                   asp-action="Edit"
                                   asp-route-productId="@Model[i].Id">Редактировать</a>
                            </td>
                            <td>
                                <a asp-area="Admin"
                                   asp-controller="Product"
                                   asp-action="Remove"
                                   asp-route-productId="@Model[i].Id">Удалить</a>
                            </td>



                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>