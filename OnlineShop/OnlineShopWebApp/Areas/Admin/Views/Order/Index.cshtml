@using OnlineShopWebApp.Areas.Admin.Controllers
@using OnlineShopWebApp.Data.Models
@model List<Order>

<div class="row">
    @await Html.PartialAsync("AdminLeftMenu")

    <div class="col-9">
        <h3>Список заказов</h3>
        <div class="row">
            <table class="table">
                <thead>
                    <tr>
                        <th>№</th>
                        <th>Сумма</th>
                        <th>Статус</th>
                        <th>Дата</th>
                        <th>Время</th>
                        <th></th>

                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        <tr>
                            <td>@(i + 1)</td>
                            <td>@Model[i].TotalAmount руб.</td>
                            <td>@EnumHelper.GetDisplayName(Model[i].Status)</td>
                            <td>@Model[i].CreatedDateTime.ToString("d")</td>
                            <td>@Model[i].CreatedDateTime.ToString("t")</td>

                            <td class="d-flex gap-2">
                                <a asp-area="Admin"
                                   asp-controller="Order"
                                   asp-action="Detail"
                                   asp-route-orderId="@Model[i].Id"
                                   class="btn btn-primary btn-sm">Подробнее</a>
                                <a asp-area="Admin"
                                   asp-controller="Order"
                                   asp-action="Edit"
                                   asp-route-orderId="@Model[i].Id"
                                   class="btn btn-outline-secondary btn-sm">Редактировать</a>
                            </td>

                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>