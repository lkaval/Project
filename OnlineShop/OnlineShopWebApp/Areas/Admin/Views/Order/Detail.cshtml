@using OnlineShopWebApp.Areas.Admin.Controllers
@using OnlineShopWebApp.Data.Models
@model Order  

<form method="post">
    <div class="row">
        <div class="col-6">
            <table class="table">
                <tr>
                    <td>Дата и время</td>
                    <td>@Model.CreatedDateTime.ToString("g")</td>
                </tr>
                <tr>
                    <td>Адрес доставки</td>
                    <td>@Model.User.Address</td>
                </tr>
                <tr>
                    <td>Получатель</td>
                    <td>@Model.User.Name</td>
                </tr>
                <tr>
                    <td>Телефон</td>
                    <td>@Model.User.Phone</td>
                </tr>
                <tr>
                    <td>Сумма заказа руб.</td>
                    <td>@Model.TotalAmount</td>
                </tr>
                <tr>
                    <td>Статус заказа</td>
                    <td>
                        <select asp-for="@Model.Status"
                                asp-items="@Html.GetEnumSelectList<OrderStatus>()"
                                class="form-control">
                        </select>
                    </td>
                </tr>
            </table>
        </div>
    </div>
    <br />
        <button class="btn btn-success" type="submit" 
        asp-area="Admin"
        asp-controller="Order" 
        asp-action="UpdateOrderStatus" 
        asp-route-orderId="@Model.Id"> Изменить статус заказа

        </button>
    
</form>