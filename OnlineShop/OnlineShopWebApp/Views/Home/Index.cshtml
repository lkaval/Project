@using OnlineShopWebApp.Data.Models
@model IEnumerable<Product>
<link rel="stylesheet" href="~/css/homePage.css" />
<h1 class="mb-4">Список товаров</h1>
<div class="row">
    @foreach (var product in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card product-card">
                <div class="card-img-container">
                    <img src="@product.ImagePath" class="card-img-top" alt="@product.Name" />
                </div>
                <div class="card-body">
                    <h5 class="card-title">@product.Name</h5>
                    <p class="card-text"><strong>Стоимость:</strong> @product.Cost.ToString("N2") руб.</p>
                    <div class="btn-group-left">
                        <a asp-area=""
                           asp-controller="Product"
                           asp-action="Details"
                           asp-route-id="@product.Id"
                           class="btn btn-primary">Подробнее</a>
                        <a asp-area=""
                           asp-controller="Cart"
                           asp-action="Add"
                           asp-route-productID="@product.Id"
                           class="btn btn-success">Добавить в корзину</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>