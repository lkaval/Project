@using OnlineShopWebApp.Data.Models
@model Cart
<link rel="stylesheet" href="~/css/cart.css" />

<div class="cart-container">
    <h1>Корзина</h1>

    @if (Model == null || !Model.Items.Any())
    {
        <div class="empty-cart">
            <p>Ваша корзина пуста.</p>
            <a href="/" class="btn btn-primary">Начать покупки</a>
        </div>
    }
    else
    {
        <div class="cart-content">
            <table class="table">
                <thead class="thead-light">
                    <tr>
                        <th>Товар</th>
                        <th>Цена</th>
                        <th>Количество</th>
                        <th>Итого</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@item.Product.Name</td>
                            <td>@item.Product.Cost.ToString("N2") руб.</td>
                            <td class="quantity-cell">
                                <div class="quantity-controls">
                                    <a href="/cart/decreaseAmount?productId=@item.Product.Id" class="btn btn-outline-secondary">-</a>
                                    <span class="quantity">@item.Quantity</span>
                                    <a href="/cart/add?productId=@item.Product.Id" class="btn btn-outline-secondary">+</a>
                                </div>
                            </td>
                            <td>@item.Amount.ToString("N2") руб.</td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="cart-summary">
                <h3>Общая стоимость: @Model.TotalAmount.ToString("N2") руб.</h3>
                <div class="cart-actions">
                    <a href="/order/index" class="btn btn-success">Оформить заказ</a>
                    <a href="/cart/clear" class="btn btn-danger">Очистить корзину</a>
                    <a href="/" class="btn btn-primary">Продолжить покупки</a>
                </div>
            </div>
        </div>
    }
</div>