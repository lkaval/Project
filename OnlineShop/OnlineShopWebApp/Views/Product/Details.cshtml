@using OnlineShopWebApp.Data.Models
@model Product
<link rel="stylesheet" href="~/css/details.css" />
<h1>@Model.Name</h1>
<div class="row">
    <div class="col-md-6">
        <div class="product-image-container">
            <img src="@Model.ImagePath" class="product-image" alt="@Model.Name" />
        </div>
    </div>
    <div class="col-md-6">
        <p><strong>Стоимость:</strong> @Model.Cost руб.</p>
        <div class="product-description">
            <strong>Описание:</strong> @Model.Description
        </div>
    </div>

    <div class="product-actions col-12">
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Продолжить покупки</a>
        <a asp-controller="Cart" asp-action="Add" asp-route-productID="@Model.Id" class="btn btn-success">Добавить в корзину</a>
    </div>
</div>