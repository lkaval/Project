@using OnlineShopWebApp.Areas.Admin.Models
@using OnlineShopWebApp.Data.Models
@model Authorization
<link rel="stylesheet" href="~/css/authorization.css" />

<form method="post" class="auth-form" asp-action="Authorization" asp-controller="Account">
    <div class="text-danger font-weight-bold" asp-validation-summary="ModelOnly"></div>

    <div class="form-header">
        <h3 class="form-title">Вход в систему</h3>
    </div>

    <div class="form-group">
        <label asp-for="Login" class="form-label">Логин</label>
        <div class="input-container">
            <input asp-for="Login" class="form-control" placeholder="Введите ваш логин" />
            <span asp-validation-for="Login" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group">
        <label asp-for="Password" class="form-label">Пароль</label>
        <div class="input-container">
            <input asp-for="Password" class="form-control" placeholder="Введите ваш пароль" type="password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group remember-me">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" asp-for="RememberMe" />
            <label class="form-check-label" asp-for="RememberMe">Запомнить меня</label>
        </div>
    </div>

    <div class="form-actions">
        <button asp-controller="Account" asp-action="Authorization" type="submit" class="btn btn-primary submit-btn">
            Войти
        </button>
    </div>

    <div class="form-footer">
        <a href="#" class="forgot-password">Забыли пароль?</a>
        <a asp-controller="Account" asp-action="Registration" class="register-link">
            Зарегистрироваться
        </a>
    </div>
</form>