@using OnlineShopWebApp.Areas.Admin.Models
@using OnlineShopWebApp.Data.Models
@model Registration
<link rel="stylesheet" href="~/css/registration.css" />

<form method="post" class="auth-form" asp-action="Registration" asp-controller="Account">
    <div class="text-danger font-weight-bold" asp-validation-summary="ModelOnly"></div>

    <div class="form-header">
        <h3 class="form-title">Регистрация</h3>
    </div>

    <div class="form-group">
        <label asp-for="Login" class="form-label">Логин</label>
        <div class="input-container">
            <input asp-for="Login" class="form-control" placeholder="Введите ваш email" />
            <span asp-validation-for="Login" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group">
        <label asp-for="Password" class="form-label">Пароль</label>
        <div class="input-container">
            <input asp-for="Password" class="form-control" placeholder="Введите ваш пароль" type="password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group">
        <label asp-for="ConfirmPassword" class="form-label">Подтверждение пароля</label>
        <div class="input-container">
            <input asp-for="ConfirmPassword" class="form-control" placeholder="Подтвердите ваш пароль" type="password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary submit-btn">
            Зарегистрироваться
        </button>
    </div>
</form>